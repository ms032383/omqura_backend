# FastAPI Backend Configuration

# Set the URL of the Ollama server.
# Replace 192.168.1.12 with your secondary laptop's IP address.
# Make sure Ollama is serving on 0.0.0.0 (by running: $env:OLLAMA_HOST="0.0.0.0"; ollama serve)
OLLAMA_URL=http://192.168.1.12:11434/api/generate

# Backend Server Port
PORT=8000
